{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "dominion-house",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference, the service name must match the worker name
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dominion-house"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "53000a2ca4c749aab33b34a428542ce6"
    }
  ],
  // Custom domains: Cloudflare creates the DNS records and certificates. The old
  // site's records for these names have to be gone before the first deploy.
  "workers_dev": true,
  "routes": [
    { "pattern": "dominionhouse.org", "custom_domain": true },
    { "pattern": "www.dominionhouse.org", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
